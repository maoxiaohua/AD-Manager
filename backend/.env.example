# AD Hostname Manager - Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=AD Hostname Manager
APP_VERSION=1.0.0
SECRET_KEY=change-me-to-a-random-secret-string

# Database
DATABASE_URL=sqlite:///./ad_manager.db

# Default admin password (change after first login!)
DEFAULT_ADMIN_PASSWORD=admin123

# LDAP Configuration (optional - configure via Settings UI)
LDAP_SERVER_URL=
LDAP_DOMAIN=
LDAP_ADMIN_USERNAME=
LDAP_ADMIN_PASSWORD=
LDAP_BASE_DN=
LDAP_USE_SSL=true
LDAP_TLS_VALIDATE=CERT_NONE
LDAP_PAGE_SIZE=500
LDAP_RECEIVE_TIMEOUT=300

# Location-based sync (optional — set to e.g. "OU=locations" if your AD uses this pattern)
LOCATION_BASE_OU=

# Sync tuning
LOCKOUT_THRESHOLD=5
SYNC_MISFIRE_GRACE=300
USER_STATUS_MISFIRE_GRACE=120
SCHEDULER_TIMEZONE=Asia/Shanghai

# Sync Schedule (cron expression) and log retention
SYNC_SCHEDULE=0 2 * * *
SYNC_LOG_RETENTION_DAYS=30

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=480
